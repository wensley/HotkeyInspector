<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\HotkeyInspector.Core\HotkeyInspector.Core.csproj" />
    <ProjectReference Include="..\HotkeyInspector.Infrastructure\HotkeyInspector.Infrastructure.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>HotkeyInspector</AssemblyName>
    <RootNamespace>HotkeyInspector.App</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Version>0.0.1</Version>
    <Company>zuhejian.com</Company>
    <Product>Hotkey Inspector</Product>
    <Description>Check whether a Windows global hotkey is already taken, and by which app.</Description>
    <!--
      WFO0003：WinForms 分析器建议用 ApplicationHighDpiMode 属性替代清单里的 DPI 设置。
      本应用以 WPF 为主，仅用 WinForms 的 NotifyIcon 做托盘图标，DPI 感知需要由清单声明，
      因此保留清单设置并抑制该提示。
    -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

</Project>
