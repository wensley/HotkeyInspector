<Window x:Class="HotkeyInspector.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        xmlns:local="clr-namespace:HotkeyInspector.App"
        Title="{Binding [AppTitle], Source={x:Static local:Localization.Instance}}"
        Width="1240"
        Height="740"
        MinWidth="1040"
        MinHeight="560"
        Background="{StaticResource SurfaceBrush}"
        Closing="Window_Closing"
        KeyDown="Window_KeyDown">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,16" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="{Binding [AppTitle], Source={x:Static local:Localization.Instance}}"
                           FontSize="28"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding [Subtitle], Source={x:Static local:Localization.Instance}}"
                           Foreground="#5B6472"
                           TextWrapping="Wrap"
                           MaxWidth="900"
                           Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="{Binding [BtnDotnet], Source={x:Static local:Localization.Instance}}"
                        Click="DownloadDotnetButton_Click" />
                <Button x:Name="LanguageButton"
                        Content="{Binding [BtnLanguage], Source={x:Static local:Localization.Instance}}"
                        Click="LanguageButton_Click"
                        Margin="0" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1"
                Background="White"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14"
                Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Text="{Binding [LabelHotkey], Source={x:Static local:Localization.Instance}}"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0" />
                <TextBox x:Name="HotkeyTextBox"
                         Grid.Row="0"
                         Grid.Column="1"
                         Text="Ctrl+Alt+K"
                         GotFocus="HotkeyTextBox_GotFocus"
                         LostFocus="HotkeyTextBox_LostFocus"
                         PreviewKeyDown="HotkeyTextBox_PreviewKeyDown" />
                <StackPanel Grid.Row="0"
                            Grid.Column="2"
                            Orientation="Horizontal"
                            Margin="10,0,0,0">
                    <Button Content="{Binding [BtnCheck], Source={x:Static local:Localization.Instance}}"
                            Click="CheckButton_Click" />
                    <primitives:ToggleButton x:Name="CaptureToggle"
                                             Content="{Binding [BtnCapture], Source={x:Static local:Localization.Instance}}"
                                             MinHeight="32"
                                             Padding="14,6"
                                             Margin="0,0,8,0" />
                    <Button Content="{Binding [BtnScan], Source={x:Static local:Localization.Instance}}"
                            Click="ScanButton_Click" />
                    <Button Content="{Binding [BtnExport], Source={x:Static local:Localization.Instance}}"
                            Click="ExportButton_Click" />
                    <Button Content="{Binding [BtnLockCapture], Source={x:Static local:Localization.Instance}}"
                            Click="LockCaptureButton_Click"
                            Margin="0" />
                </StackPanel>

                <TextBlock Grid.Row="1"
                           Grid.Column="1"
                           Grid.ColumnSpan="2"
                           Text="{Binding [InputHint], Source={x:Static local:Localization.Instance}}"
                           Foreground="#3E6DB5"
                           TextWrapping="Wrap"
                           Margin="0,10,0,0" />

                <Border x:Name="CapturePrompt"
                        Grid.Row="2"
                        Grid.Column="1"
                        Grid.ColumnSpan="2"
                        Background="#FFF6E5"
                        BorderBrush="#F0C36D"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10,8"
                        Margin="0,8,0,0"
                        Visibility="Collapsed">
                    <TextBlock Text="{Binding [CapturePrompt], Source={x:Static local:Localization.Instance}}"
                               Foreground="#8A5B00"
                               TextWrapping="Wrap" />
                </Border>

                <TextBlock Grid.Row="3"
                           Grid.Column="1"
                           Grid.ColumnSpan="2"
                           Text="{Binding [Hint], Source={x:Static local:Localization.Instance}}"
                           Foreground="#5B6472"
                           TextWrapping="Wrap"
                           Margin="0,10,0,0" />

                <!-- 实时知识库匹配（非锁定识别器） -->
                <Border x:Name="LiveMatchesPanel"
                        Grid.Row="4"
                        Grid.Column="1"
                        Grid.ColumnSpan="2"
                        Background="#F6F8FB"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10,8"
                        Margin="0,10,0,0"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="{Binding [LiveMatchesTitle], Source={x:Static local:Localization.Instance}}"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6" />
                        <TextBlock x:Name="LiveMatchesText"
                                   TextWrapping="Wrap"
                                   Foreground="#374151" />
                    </StackPanel>
                </Border>

                <!-- 系统保留快捷键 -->
                <StackPanel Grid.Row="5"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            Margin="0,10,0,0">
                    <ToggleButton x:Name="ReservedToggle"
                                  Content="{Binding [ReservedTitle], Source={x:Static local:Localization.Instance}}"
                                  HorizontalAlignment="Left"
                                  MinHeight="30"
                                  Padding="12,4"
                                  Checked="ReservedToggle_Changed"
                                  Unchecked="ReservedToggle_Changed" />
                    <Border x:Name="ReservedPanel"
                            Background="#F6F8FB"
                            BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,8"
                            Margin="0,8,0,0"
                            Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="ReservedCapturableLabel"
                                       FontWeight="SemiBold"
                                       Foreground="#3E6DB5"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="ReservedCapturableText"
                                       TextWrapping="Wrap"
                                       Foreground="#374151"
                                       Margin="0,4,0,0" />
                            <TextBlock x:Name="ReservedUncapturableLabel"
                                       FontWeight="SemiBold"
                                       Foreground="#B26A00"
                                       TextWrapping="Wrap"
                                       Margin="0,10,0,0" />
                            <TextBlock x:Name="ReservedUncapturableText"
                                       TextWrapping="Wrap"
                                       Foreground="#374151"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <DataGrid x:Name="ResultsGrid"
                  Grid.Row="2"
                  ItemsSource="{Binding Results}"
                  IsReadOnly="True"
                  Background="White">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{Binding [ColHotkey], Source={x:Static local:Localization.Instance}}" Binding="{Binding Hotkey}" Width="130" />
                <DataGridTextColumn Header="{Binding [ColStatus], Source={x:Static local:Localization.Instance}}" Binding="{Binding Status}" Width="72" />
                <DataGridTextColumn Header="{Binding [ColOwner], Source={x:Static local:Localization.Instance}}" Binding="{Binding OwnerApplication}" Width="150" />
                <DataGridTextColumn Header="{Binding [ColDetail], Source={x:Static local:Localization.Instance}}" Binding="{Binding Detail}" Width="*" MinWidth="220" />
                <DataGridTextColumn Header="{Binding [ColKnowledge], Source={x:Static local:Localization.Instance}}" Binding="{Binding Knowledge}" Width="260" />
                <DataGridTextColumn Header="{Binding [ColCandidates], Source={x:Static local:Localization.Instance}}" Binding="{Binding CandidateProcesses}" Width="150" />
                <DataGridTextColumn Header="{Binding [ColError], Source={x:Static local:Localization.Instance}}" Binding="{Binding ErrorCode}" Width="60" />
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="{Binding [BtnCopy], Source={x:Static local:Localization.Instance}}"
                        Click="CopyButton_Click" />
                <Button Content="{Binding [BtnClear], Source={x:Static local:Localization.Instance}}"
                        Click="ClearButton_Click"
                        Margin="0" />
            </StackPanel>
            <TextBlock x:Name="StatusText"
                       Text="{Binding [StatusReady], Source={x:Static local:Localization.Instance}}"
                       VerticalAlignment="Center"
                       Foreground="#5B6472" />
        </DockPanel>

        <!-- 全屏锁定捕获覆盖层 -->
        <Grid x:Name="CaptureOverlay"
              Grid.RowSpan="4"
              Background="#F2FFFFFF"
              Visibility="Collapsed">
            <Border Background="White"
                    BorderBrush="{StaticResource AccentBrush}"
                    BorderThickness="2"
                    CornerRadius="14"
                    Padding="40"
                    MaxWidth="820"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{Binding [CaptureTitle], Source={x:Static local:Localization.Instance}}"
                               FontSize="24"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="CaptureComboText"
                               Text="{Binding [CaptureHint], Source={x:Static local:Localization.Instance}}"
                               FontSize="40"
                               FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,20,0,6" />
                    <TextBlock x:Name="CaptureModsText"
                               Text=""
                               FontSize="16"
                               Foreground="#5B6472"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,16" />

                    <Border x:Name="CaptureMatchesPanel"
                            Background="#F6F8FB"
                            BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12"
                            Margin="0,0,0,16"
                            Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="{Binding [CaptureMatches], Source={x:Static local:Localization.Instance}}"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,6" />
                            <TextBlock x:Name="CaptureMatchesText"
                                       TextWrapping="Wrap"
                                       Foreground="#374151" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding [CaptureUseHint], Source={x:Static local:Localization.Instance}}"
                               Foreground="#5B6472"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10" />
                    <TextBlock Text="{Binding [CaptureNote], Source={x:Static local:Localization.Instance}}"
                               Foreground="#8A94A6"
                               TextWrapping="Wrap"
                               Margin="0,0,0,16" />
                    <Button Content="{Binding [CaptureExitHint], Source={x:Static local:Localization.Instance}}"
                            HorizontalAlignment="Center"
                            Margin="0"
                            Click="ExitCaptureButton_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
